maps:
  - type: STR_FIRST_MISSION
    premade: MVA_SpaceBlock01
  - type: STR_SECOND_MISSION
    generator: 1
    size: [12,12]
    mapScript:
      - command: placeBlock
        blocks: [QUADRANT_ONE]
        rects: 
          - [0, 0]


# TargetModeType:     0=Self, 1=Single, 2=Multiple
# TargetTypes(flags): 0=None, 1=Floor, 2=Wall, 4=Enemies, 8=Friendlies
# TargetPresets:      0=None, 1=CardinalMelee, 2=RangedAttack, 3=VisibleTiles, 4=ReachableTiles
# AffectedPreset:     0=None, 1=Explosion, 2=Straight Line
# EndCondition:       0=None, 1=OnFirstAttack
skills:
  - name: OpenDoor
    targetMode:
      type: 0
    effects:
      - name: OpenDoorEffect
  - name: MeleeAttack
    isMelee: true
    targetMode:
      type: 1
      allowedTargetTypes: 12
      allowedTargetPreset: 1
      affectedTiles: [[0,0]]
    effects:
      - name: Attack
  - name: RangedAttack
    targetMode:
      type: 1
      allowedTargetTypes: 12
      allowedTargetPreset: 2
      affectedTiles: [[0,0]]
    effects:
      - name: Attack
      - name: ProjectileEffect
        integerOne: 1
        integerTwo: 3
        floatOne: 8
  - name: RocketLauncher
    displayName: "Rocket\nLauncher"
    targetMode:
      type: 1
      allowedTargetTypes: 13
      allowedTargetPreset: 2
      activeAffectedPreset: 1
      affectedRange: 1
    effects:
      - name: ProjectileEffect
        integerOne: 4
        integerTwo: 1
        floatOne: 4
      - name: Explosion
        chained: true
  - name: StunMelee
    displayName: "Stun\nStrike"
    isMelee: true
    targetMode:
      type: 1
      allowedTargetTypes: 12
      allowedTargetPreset: 1
      affectedTiles: [[0,0]]
    buffs:
      - name: Stun
        timer: 2
  - name: DeployDrone
    displayName: "Deploy\nDrone"
    isMelee: true
    targetMode:
      type: 1
      allowedTargetTypes: 1
      allowedTargetPreset: 1
      affectedTiles: [[0,0]]
    effects:
      - name: SpawnUnit
        stringOne: STR_DRONE
  - name: AimedShot
    displayName: "Aimed\nShot"
    targetMode:
      type: 0
    buffs:
      - name: Buff
        statModifiers:
          - name: Accuracy
            value: 30
        endCondition: 1

mapBlocks:
  - type: QUADRANT_ONE
    size: [12,12]
    rooms:
      - [0, 7, 4, 11]
      - [2, 2, 6, 4]
      - [7, 0, 11, 4]
    horizontalWalls:
      - [9, 9, 9, 9]
      - [10, 7, 11, 7]
    verticalWalls:
      - [6, 5, 6, 9]
      - [9, 8, 9, 9]
    horizontalDoors:
      - [1, 6, 2, 7]
      - [4, 1, 5, 2]
      - [9, 4, 10, 5]
      - [7, 9, 8, 10]


spawns:
  - faction: STR_GREEN_MARINES
    locations:
      - [0,0]
      - [0,1]
      - [1,0]
      - [1,1]
      - [1,2]
  - faction: STR_RED_SPACEMEN
    locations:
      - [11,11]
      - [10,11]
      - [11,10]
      - [10,10]
      - [9,10]
  - faction: STR_ALIENS
    randomPlacement: true

factions:
  - type: STR_GREEN_MARINES
    spritePrefix: Marine
    color: [57,135,203,1]
    loadOut:
      - unit: STR_ROGUE
        weapons:
          - STR_HARD_HITTER
      - unit: STR_HUNTER
        weapons:
          - STR_NORMAL_HITTER
          - STR_RIFLE
      - unit: STR_HEAVY
        weapons:
          - STR_NORMAL_HITTER
          - STR_ROCKET_LAUNCHER
      - unit: STR_ENGINEER
        weapons:
          - STR_NORMAL_HITTER
          - STR_HEAVY_ASSAULT_CANNON
      - unit: STR_DRONE
        doNotSpawn: true
        weapons:
          - STR_NORMAL_HITTER
  - type: STR_RED_SPACEMEN
    spritePrefix: RedSpace
    color: [226,55,60,1]
    loadOut:
      - unit: STR_ROGUE
        weapons:
          - STR_HARD_HITTER
      - unit: STR_HUNTER
        weapons:
          - STR_NORMAL_HITTER
          - STR_RIFLE
      - unit: STR_HEAVY
        weapons:
          - STR_NORMAL_HITTER
          - STR_ROCKET_LAUNCHER
      - unit: STR_ENGINEER
        weapons:
          - STR_NORMAL_HITTER
          - STR_HEAVY_ASSAULT_CANNON
      - unit: STR_DRONE
        doNotSpawn: true
        weapons:
          - STR_NORMAL_HITTER
  - type: STR_ALIENS
    spritePrefix: Alien
    color: [177, 52, 235, 1]
    loadOut:
      - unit: STR_ANDROID_ALIEN
        count: 3
        weapons:
          - STR_HEAVY_HITTER
          - STR_ANDROID_RIFLE
      - unit: STR_BIG_ALIEN
        count: 1
        weapons:
          - STR_HARD_HITTER
          - STR_ROCKET_LAUNCHER
      - unit: STR_SPIDER_ALIEN
        count: 8
        weapons:
          - STR_LOW_HITTER
          - STR_RIFLE
      - unit: STR_RIFLE_ALIEN
        count: 8
        weapons:
          - STR_NORMAL_HITTER
          - STR_RIFLE
      - unit: STR_DRONE
        doNotSpawn: true
        weapons:
          - STR_NORMAL_HITTER
units:
  - type: STR_DRONE
    unitSprite: NeutralDrone
    spriteHasNoFactionPrefix: true
    visionRange: 10
    accuracy: 65
    defense: 0
    movement: 4
    health: 3
    armor: 2
  - type: STR_ROGUE
    unitSprite: Shotgun
    visionRange: 10
    accuracy: 65
    defense: 0
    movement: 4
    health: 5
    armor: 1
    unitSkills:
      - StunMelee
  - type: STR_HEAVY
    visionRange: 10
    accuracy: 65
    defense: 0
    movement: 4
    health: 5
    armor: 2
    unitSkills:
      - RocketLauncher
  - type: STR_HUNTER
    visionRange: 10
    accuracy: 70
    defense: 0
    movement: 6
    health: 6
    armor: 2
    unitSkills:
      - AimedShot
  - type: STR_ENGINEER
    visionRange: 10
    accuracy: 65
    defense: 0
    movement: 4
    health: 5
    armor: 1
    unitSkills:
      - DeployDrone
  - type: STR_SPIDER_ALIEN
    visionRange: 12
    accuracy: 60
    defense: 10
    unitSprite: Spider
    movement: 8
    health: 3
    armor: 1
  - type: STR_ANDROID_ALIEN
    visionRange: 8
    defense: 10
    accuracy: 60
    unitSprite: Android
    movement: 4
    health: 5
    armor: 2
  - type: STR_RIFLE_ALIEN
    visionRange: 10
    defense: 10
    accuracy: 65  
    unitSprite: Rifle
    movement: 6
    health: 4
    armor: 1
  - type: STR_BIG_ALIEN
    visionRange: 10
    defense: 20
    accuracy: 70  
    unitSprite: Rocket
    movement: 4
    health: 8
    armor: 4
#    occupiedTiles: [[0,0],[0,1],[1,0],[1,1]]
#    canMoveDiagonally: false

weapons:
  - type: STR_HARD_HITTER
    damage:
      - [3,4]
    isMelee: true
  - type: STR_RIFLE
    minRange: 1
    maxRange: 8
    weaponSprite: Rifle
    damage:
      - [1,3]
  - type: STR_ANDROID_RIFLE
    maxRange: 20
    maxDropOff: 10
    minRange: 6
    minDropOff: 10
    accuracyModifier: 10
    weaponSprite: Rifle
    damage:
      - [1,4]
  - type: STR_LOW_HITTER
    damage:
      - [1]
    isMelee: true
  - type: STR_NORMAL_HITTER
    damage:
      - [1,2]
    isMelee: true
  - type: STR_HEAVY_HITTER
    damage:
      - [3,4]
    isMelee: true
  - type: STR_ROCKET_LAUNCHER
    accuracyModifier: -10
    weaponSprite: Rocket
    damage:
      - [3]
    radius: 1
  - type: STR_HEAVY_ASSAULT_CANNON
    weaponSprite: Heavy
    damage:
      - [2,4]
    multipleTargets: true
    damageDistribution: true
  - type: STR_PLASMA_GUN
    weaponSprite: Heavy
    damage:
      - [1,3]
    straightLineOnly: true
    damageLineOfFire: true

translations:
  - lang: en-US
    strings:
      STR_FIRST_MISSION: Mission One
      STR_ALIENS: Alien Lifeforms
      STR_GREEN_MARINES: Colonial Marines
      STR_RED_SPACEMEN: Travellers
      STR_YELLOW_MARINES: Legion
      STR_SPIDER_ALIEN: Spiderbrain
      STR_RIFLE_ALIEN: Xenophob
      STR_SQUADDIE: Space Marine
      STR_SQUAD_LEADER: Squad Leader
      STR_PLASMA_GUN: Plasma Gun
      STR_HEAVY_ASSAULT_CANNON: Assault Cannon
      STR_ROCKET_LAUNCHER: Missile Launcher
      STR_NORMAL_HITTER: Melee
      STR_RIFLE: Plasma Rifle
      STR_HARD_HITTER: Charged Punch
      STR_ANDROID_ALIEN: Manic-depressive Android
      STR_HEAVY_HITTER: Mechanic Punch
      STR_ANDROID_RIFLE: Laser Rifle
      STR_BIG_ALIEN: Cyclone Soldier
      STR_LOW_HITTER: Pummel
      STR_ROGUE: Rogue
      STR_HUNTER: Bounty Hunter
      STR_HEAVY: Heavy Weapons Expert
      STR_ENGINEER: Engineer