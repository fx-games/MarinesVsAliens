maps:
  - type: STR_FIRST_MISSION
    premade: MVA_SpaceBlock01
  - type: STR_SECOND_MISSION
    generator: 1
    size: [12,12]
    mapScript:
      - command: placeBlock
        blocks: [QUADRANT_ONE]
        rects: 
          - [0, 0]


# TargetModeType:     0=Self, 1=Single, 2=Multiple
# TargetTypes(flags): 0=None, 1=Floor, 2=Wall, 4=Enemies, 8=Friendlies
# TargetPresets:      0=None, 1=CardinalMelee, 2=RangedAttack, 3=VisibleTiles, 4=ReachableTiles
# AffectedPreset:     0=None, 1=Explosion, 2=Straight Line
# EndCondition:       0=None, 1=OnFirstAttack
skills:
  - name: OpenDoor
    targetMode:
      type: 0
    effects:
      - name: OpenDoorEffect
  - name: MeleeAttack
    isMelee: true
    isOffensiveAction: true
    changeSpriteTo: 8
    targetMode:
      type: 1
      allowedTargetTypes: 12
      allowedTargetPreset: 1
      affectedTiles: [[0,0]]
    effects:
      - name: MeleeHitEffect
      - name: Attack
        chained: true
        lastEffect: true
  - name: RangedAttack
    isOffensiveAction: true
    targetMode:
      type: 1
      allowedTargetTypes: 12
      allowedTargetPreset: 2
      affectedTiles: [[0,0]]
    effects:
      - name: ProjectileEffect
        integerOne: 1
        integerTwo: 3
        floatOne: 8
      - name: Attack
        chained: true
      - name: ExplosionEffect
        chained: true
        lastEffect: true
  - name: RocketLauncher
    displayName: "Rocket\nLauncher"
    isOffensiveAction: true
    changeSpriteTo: 10
    targetMode:
      type: 1
      allowedTargetTypes: 13
      allowedTargetPreset: 2
      activeAffectedPreset: 1
      affectedRange: 1
    effects:
      - name: ProjectileEffect
        integerOne: 4
        integerTwo: 1
        floatOne: 4
      - name: Explosion
        chained: true
      - name: ExplosionEffect
        chained: true
        lastEffect: true
  - name: StunMelee
    displayName: "Stun\nStrike"
    changeSpriteTo: 0
    isMelee: true
    targetMode:
      type: 1
      allowedTargetTypes: 12
      allowedTargetPreset: 1
      affectedTiles: [[0,0]]
    buffs:
      - name: Stun
        timer: 2
  - name: DeployDrone
    displayName: "Deploy\nDrone"
    isMelee: true
    targetMode:
      type: 1
      allowedTargetTypes: 1
      allowedTargetPreset: 1
      affectedTiles: [[0,0]]
    effects:
      - name: SpawnUnit
        stringOne: STR_DRONE
  - name: AimedShot
    displayName: "Aimed\nShot"
    targetMode:
      type: 0
    buffs:
      - name: Buff
        statModifiers:
          - name: Accuracy
            value: 30
        endCondition: 1

mapBlocks:
  - type: QUADRANT_ONE
    size: [12,12]
    rooms:
      - [0, 7, 4, 11]
      - [2, 2, 6, 4]
      - [7, 0, 11, 4]
    horizontalWalls:
      - [9, 9, 9, 9]
      - [10, 7, 11, 7]
    verticalWalls:
      - [6, 5, 6, 9]
      - [9, 8, 9, 9]
    horizontalDoors:
      - [1, 6, 2, 7]
      - [4, 1, 5, 2]
      - [9, 4, 10, 5]
      - [7, 9, 8, 10]

factions:
  - type: STR_GREEN_MARINES
    factionPrefab: 0
    color: [57,135,203,1]
    loadOut:
      - unit: STR_ROGUE
        weapons:
          - STR_HARD_HITTER
      - unit: STR_HUNTER
        weapons:
          - STR_NORMAL_HITTER
          - STR_RIFLE
      - unit: STR_HEAVY
        weapons:
          - STR_NORMAL_HITTER
          - STR_ROCKET_LAUNCHER
      - unit: STR_ENGINEER
        weapons:
          - STR_NORMAL_HITTER
          - STR_HEAVY_ASSAULT_CANNON
      - unit: STR_DRONE
        doNotSpawn: true
        weapons:
          - STR_NORMAL_HITTER
  - type: STR_RED_SPACEMEN
    factionPrefab: 3
    color: [226,55,60,1]
    loadOut:
