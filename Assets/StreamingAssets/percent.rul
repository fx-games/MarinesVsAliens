          - STR_HARD_HITTER
      - unit: STR_HUNTER
        weapons:
          - STR_NORMAL_HITTER
          - STR_RIFLE
      - unit: STR_HEAVY
        weapons:
          - STR_NORMAL_HITTER
          - STR_ROCKET_LAUNCHER
      - unit: STR_ENGINEER
        weapons:
          - STR_NORMAL_HITTER
          - STR_HEAVY_ASSAULT_CANNON
      - unit: STR_DRONE
        doNotSpawn: true
        weapons:
          - STR_NORMAL_HITTER
  - type: STR_BLUE_BIRD_PEOPLE
    factionPrefab: 1
    color: [226,55,60,1]
    loadOut:
      - unit: STR_ROGUE
        weapons:
          - STR_HARD_HITTER
      - unit: STR_HUNTER
        weapons:
          - STR_NORMAL_HITTER
          - STR_RIFLE
      - unit: STR_HEAVY
        weapons:
          - STR_NORMAL_HITTER
          - STR_ROCKET_LAUNCHER
      - unit: STR_ENGINEER
        weapons:
          - STR_NORMAL_HITTER
          - STR_HEAVY_ASSAULT_CANNON
      - unit: STR_DRONE
        doNotSpawn: true
        weapons:
          - STR_NORMAL_HITTER
  - type: STR_YELLOW_ROBOTS
    factionPrefab: 2
    color: [226,55,60,1]
    loadOut:
      - unit: STR_ROGUE
        weapons:
          - STR_HARD_HITTER
      - unit: STR_HUNTER
        weapons:
          - STR_NORMAL_HITTER
          - STR_RIFLE
      - unit: STR_HEAVY
        weapons:
          - STR_NORMAL_HITTER
          - STR_ROCKET_LAUNCHER
      - unit: STR_ENGINEER
        weapons:
          - STR_NORMAL_HITTER
          - STR_HEAVY_ASSAULT_CANNON
      - unit: STR_DRONE
        doNotSpawn: true
        weapons:
          - STR_NORMAL_HITTER

units:
  - type: STR_DRONE
    factionPrefab: 4 # DroneUnits
    spriteOffset: 0
    stats:
      ActionPoints: 4
      VisionRange: 10
      Accuracy: 65
      Defense: 0
      Movement: 4
      Health: 3
      Armor: 2
  - type: STR_ROGUE
    spriteOffset: 8
    stats:
      ActionPoints: 4
      VisionRange: 10
      Accuracy: 65
      Defense: 0
      Movement: 4
      Health: 5
      Armor: 1
    unitSkills:
      - StunMelee
  - type: STR_HEAVY
    spriteOffset: 14
    stats:
      ActionPoints: 4
      VisionRange: 10
      Accuracy: 65
      Defense: 0
      Movement: 4
      Health: 5
      Armor: 2
    unitSkills:
      - RocketLauncher
  - type: STR_HUNTER
    spriteOffset: 2
    stats:
      ActionPoints: 4
      VisionRange: 10
      Accuracy: 70
      Defense: 0
      Movement: 6
      Health: 6
      Armor: 2
    unitSkills:
      - AimedShot
  - type: STR_ENGINEER
    spriteOffset: 4
    stats:
      ActionPoints: 4
      VisionRange: 10
      Accuracy: 65
      Defense: 0
      Movement: 4
      Health: 5
      Armor: 1
    unitSkills:
      - DeployDrone

#    occupiedTiles: [[0,0],[0,1],[1,0],[1,1]]
#    canMoveDiagonally: false

weapons:
  - type: STR_HARD_HITTER
    useCost: 3
    damage:
      - [3,4]
    isMelee: true
  - type: STR_RIFLE
    useCost: 2
    minRange: 1
    maxRange: 8
    weaponSprite: Rifle
    damage:
      - [1,3]
  - type: STR_ANDROID_RIFLE
    useCost: 3
    maxRange: 20
    maxDropOff: 10
    minRange: 6
    minDropOff: 10
    accuracyModifier: 10
    weaponSprite: Rifle
    damage:
      - [1,4]
  - type: STR_LOW_HITTER
    useCost: 2
    damage:
      - [1]
    isMelee: true
  - type: STR_NORMAL_HITTER
    useCost: 2
    damage:
      - [1,2]
    isMelee: true
  - type: STR_HEAVY_HITTER
    useCost: 2
    damage:
      - [3,4]
    isMelee: true
  - type: STR_ROCKET_LAUNCHER
    accuracyModifier: -10
    weaponSprite: Rocket
    useCost: 3
    damage:
      - [3]
    radius: 1
  - type: STR_HEAVY_ASSAULT_CANNON
    weaponSprite: Heavy
    useCost: 3
    damage:
      - [2,4]
    multipleTargets: true
    damageDistribution: true
  - type: STR_PLASMA_GUN
    weaponSprite: Heavy
    useCost: 3
    damage:
      - [1,3]
    straightLineOnly: true
    damageLineOfFire: true

translations:
  - lang: en-US
    strings:
      STR_FIRST_MISSION: Mission One
